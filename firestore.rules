rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function eventOf(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    function isHostOf(eventId) {
      return signedIn() && eventOf(eventId).creatorId == request.auth.uid;
    }

    match /events/{eventId} {

      // The invitation itself is public — that is the entire point of a share link.
      allow read: if true;

      allow create: if signedIn()
                    && request.resource.data.creatorId == request.auth.uid
                    && request.resource.data.attendees == 0
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 140
                    && request.resource.data.capacity is int
                    && request.resource.data.capacity >= 0;

      allow update: if isOwnerEdit() || isAttendeeCountChange();

      allow delete: if signedIn() && resource.data.creatorId == request.auth.uid;

      function isOwnerEdit() {
        return signedIn()
               && resource.data.creatorId == request.auth.uid
               && request.resource.data.creatorId == resource.data.creatorId;
      }

      // A public RSVP may nudge the headcount and nothing else. The old rule
      // checked only *which* key changed, so anyone could set it to any number.
      function isAttendeeCountChange() {
        let next = request.resource.data;
        let prev = resource.data;
        let ceiling = 1 + prev.get('maxPlusOnes', 0);
        let delta = next.attendees - prev.attendees;
        return next.diff(prev).affectedKeys().hasOnly(['attendees'])
               && next.attendees is int
               && next.attendees >= 0
               && delta >= -ceiling
               && delta <= ceiling
               && (prev.get('capacity', 0) == 0 || next.attendees <= prev.capacity);
      }

      // Guest records hold names, emails and answers.
      //
      // `list` is host-only, so the guest list can no longer be harvested in
      // bulk. `get` stays open because the document id is a SHA-256 of the
      // guest's own email — a guest can reach their own RSVP to amend it
      // without an account, but you cannot enumerate or discover others.
      match /guests/{guestId} {
        allow get: if true;
        allow list: if isHostOf(eventId);
        allow create, update: if isValidGuest(eventId);
        allow delete: if isHostOf(eventId);
      }

      function isValidGuest(eventId) {
        let d = request.resource.data;
        let ev = eventOf(eventId);
        return d.name is string && d.name.size() > 0 && d.name.size() <= 120
               && d.email is string && d.email.size() > 3 && d.email.size() <= 254
               && d.status in ['attending', 'not_attending', 'maybe', 'waitlisted']
               && d.plusOnes is int
               && d.plusOnes >= 0
               && d.plusOnes <= ev.get('maxPlusOnes', 0)
               && d.note is string && d.note.size() <= 500;
      }

      // Name-only projection so a public guest list never exposes an address.
      //
      // Deletion is open to guests because withdrawing an RSVP has to remove
      // this entry without an account, but only once the underlying reply is no
      // longer "attending" — so an entry can be cleared when it is already
      // stale, never while it is live.
      match /attendees_public/{guestId} {
        allow read: if eventOf(eventId).get('guestListPublic', false) == true
                    || isHostOf(eventId);
        allow create, update: if isValidPublicAttendee();
        allow delete: if isHostOf(eventId) || isWithdrawn(eventId, guestId);
      }

      function isWithdrawn(eventId, guestId) {
        let guestPath = /databases/$(database)/documents/events/$(eventId)/guests/$(guestId);
        return !exists(guestPath) || get(guestPath).data.status != 'attending';
      }

      function isValidPublicAttendee() {
        let d = request.resource.data;
        return d.firstName is string && d.firstName.size() > 0 && d.firstName.size() <= 60
               && d.plusOnes is int && d.plusOnes >= 0 && d.plusOnes <= 20
               && d.keys().hasOnly(['firstName', 'plusOnes', 'rsvpDate']);
      }

      match /messages/{messageId} {
        allow read: if eventOf(eventId).get('discussionEnabled', false) == true
                    || isHostOf(eventId);
        allow create: if eventOf(eventId).get('discussionEnabled', false) == true
                      && isValidMessage();
        allow update: if false;
        allow delete: if isHostOf(eventId);
      }

      function isValidMessage() {
        let d = request.resource.data;
        return d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 80
               && d.body is string && d.body.size() > 0 && d.body.size() <= 1000;
      }

      match /photos/{photoId} {
        allow read: if eventOf(eventId).get('galleryEnabled', false) == true
                    || isHostOf(eventId);
        allow create: if eventOf(eventId).get('galleryEnabled', false) == true
                      && isValidPhoto();
        allow update: if false;
        allow delete: if isHostOf(eventId);
      }

      function isValidPhoto() {
        let d = request.resource.data;
        return d.url is string && d.url.matches('https://.*')
               && d.uploaderName is string && d.uploaderName.size() <= 80
               && d.caption is string && d.caption.size() <= 200;
      }

      // Sent announcements are host-only in both directions.
      match /announcements/{announcementId} {
        allow read, write: if isHostOf(eventId);
      }
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
